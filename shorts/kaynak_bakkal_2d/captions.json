[
{
"t0": 0.96,
"t1": 1.94,
"text": "BAKKAL AMCA!",
"line": 0
},
{
"t0": 1.94,
"t1": 3.31,
"text": "ANNEM DEDİ Kİ,",
"line": 0
},
{
"t0": 3.31,
"t1": 5.91,
"text": "*DEFTERE YAZARMIŞSIN!*",
"line": 0
},
{
"t0": 7.255,
"t1": 8.879,
"text": "MAHALLENİN BAKKALI",
"line": 1
},
{
"t0": 8.879,
"t1": 10.625,
"text": "*HERKESİ TANIRDI.*",
"line": 1
},
{
"t0": 10.625,
"t1": 12.375,
"text": "EKMEK, GAZETE, GOFRET...",
"line": 1
},
{
"t0": 12.375,
"t1": 13.68,
"text": "PARAN YETMEZSE,",
"line": 1
},
{
"t0": 13.68,
"t1": 16.065,
"text": "*VERESİYE DEFTERİ* VARDI.",
"line": 1
},
{
"t0": 17.363,
"t1": 19.428,
"text": "AY SONUNDA BABALAR GELİR,",
"line": 2
},
{
"t0": 19.428,
"t1": 21.308,
"text": "DEFTERDEKİ *SAYFA KAPANIRDI.*",
"line": 2
},
{
"t0": 21.308,
"t1": 23.603,
"text": "*GÜVEN,* İMZADAN DEĞERLİYDİ.",
"line": 2
},
{
"t0": 25.029,
"t1": 27.864,
"text": "BİR DE CAM KAVANOZLARDAKİ *ŞEKERLER...*",
"line": 3
},
{
"t0": 27.864,
"t1": 28.73,
"text": "BOZUK PARAYA",
"line": 3
},
{
"t0": 28.73,
"t1": 30.409,
"text": "*AVUÇ DOLUSU ŞEKER!*",
"line": 3
},
{
"t0": 31.626,
"t1": 32.576,
"text": "PEKİ *NE OLDU?*",
"line": 4
},
{
"t0": 32.576,
"t1": 33.61,
"text": "ÖNCE *MARKETLER,*",
"line": 4
},
{
"t0": 33.61,
"t1": 35.043,
"text": "SONRA *ZİNCİR MAĞAZALAR*",
"line": 4
},
{
"t0": 35.043,
"t1": 36.506,
"text": "HER SOKAĞA AÇILDI.",
"line": 4
},
{
"t0": 38.88,
"t1": 39.883,
"text": "*KREDİ KARTI*",
"line": 5
},
{
"t0": 39.883,
"t1": 41.756,
"text": "VERESİYENİN YERİNİ ALDI.",
"line": 5
},
{
"t0": 41.756,
"t1": 43.496,
"text": "VE KÖŞEDEKİ BAKKALLAR,",
"line": 5
},
{
"t0": 43.496,
"t1": 45.82,
"text": "BİRER BİRER *KEPENK İNDİRDİ.*",
"line": 5
},
{
"t0": 47.272,
"t1": 48.387,
"text": "SENİN MAHALLENİN",
"line": 6
},
{
"t0": 48.387,
"t1": 49.857,
"text": "*BAKKALININ ADI* NEYDİ?",
"line": 6
},
{
"t0": 49.857,
"t1": 51.062,
"text": "*YORUMLARA YAZ.*",
"line": 6
},
{
"t0": 51.879,
"t1": 52.939,
"text": "KAYBOLAN MESLEKLER",
"line": 7
},
{
"t0": 52.939,
"t1": 54.959,
"text": "SERİSİNİ KAÇIRMAMAK İÇİN...",
"line": 7
},
{
"t0": 54.959,
"t1": 56.329,
"text": "*HEMEN ABONE OL!*",
"line": 7
}
]