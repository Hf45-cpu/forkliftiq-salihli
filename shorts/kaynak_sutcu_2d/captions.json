[
{
"t0": 0.96,
"t1": 2.406,
"text": "SABAHIN KÖRÜNDE",
"line": 0
},
{
"t0": 2.406,
"t1": 3.925,
"text": "BİR *ZİL SESİ...*",
"line": 0
},
{
"t0": 3.925,
"t1": 5.32,
"text": "*SÜTÇÜ GELDİ!*",
"line": 0
},
{
"t0": 6.53,
"t1": 8.11,
"text": "AT ARABASINDA *GÜĞÜMLER,*",
"line": 1
},
{
"t0": 8.11,
"t1": 9.34,
"text": "ELİNDE *ÖLÇEK.*",
"line": 1
},
{
"t0": 9.34,
"t1": 11.295,
"text": "ANNEMİZ *TENCEREYİ* UZATIR,",
"line": 1
},
{
"t0": 11.295,
"t1": 13.41,
"text": "SÜT *LİTRE LİTRE* DÖKÜLÜRDÜ.",
"line": 1
},
{
"t0": 14.65,
"t1": 17.02,
"text": "SONRA OCAKTA *KAYNATILIRDI.*",
"line": 2
},
{
"t0": 17.02,
"t1": 19.45,
"text": "GÖZ AÇIP KAPAYINCAYA KADAR *TAŞAR,*",
"line": 2
},
{
"t0": 19.45,
"t1": 21.56,
"text": "BÜTÜN MUTFAK *SÜT KOKARDI!*",
"line": 2
},
{
"t0": 23.013,
"t1": 24.581,
"text": "ÜSTÜNDEKİ *KAYMAK* İÇİN DE",
"line": 3
},
{
"t0": 24.581,
"t1": 26.343,
"text": "KARDEŞLER *KAVGA EDERDİ.*",
"line": 3
},
{
"t0": 29.147,
"t1": 30.067,
"text": "PEKİ *NE OLDU?*",
"line": 4
},
{
"t0": 30.067,
"t1": 32.197,
"text": "ÖNCE *ŞİŞE SÜT* GELDİ,",
"line": 4
},
{
"t0": 32.197,
"t1": 33.352,
"text": "SONRA *KUTU SÜT.*",
"line": 4
},
{
"t0": 33.352,
"t1": 35.867,
"text": "*MARKETLER* HER KÖŞEYE AÇILDI.",
"line": 4
},
{
"t0": 37.091,
"t1": 38.906,
"text": "*SAĞLIK KURALLARI* SIKILAŞTI,",
"line": 5
},
{
"t0": 38.906,
"t1": 41.421,
"text": "KAPI KAPI AÇIK SÜT SATIŞI *AZALDI.*",
"line": 5
},
{
"t0": 41.421,
"t1": 42.599,
"text": "VE O SABAH ZİLİ...",
"line": 5
},
{
"t0": 42.599,
"t1": 44.011,
"text": "*ARTIK ÇALMIYOR.*",
"line": 5
},
{
"t0": 46.037,
"t1": 47.232,
"text": "SENİN MAHALLENE",
"line": 6
},
{
"t0": 47.232,
"t1": 48.432,
"text": "*SÜTÇÜ* GELİR MİYDİ?",
"line": 6
},
{
"t0": 48.432,
"t1": 49.847,
"text": "*YORUMLARA YAZ.*",
"line": 6
},
{
"t0": 50.759,
"t1": 51.819,
"text": "KAYBOLAN MESLEKLER",
"line": 7
},
{
"t0": 51.819,
"t1": 53.839,
"text": "SERİSİNİ KAÇIRMAMAK İÇİN...",
"line": 7
},
{
"t0": 53.839,
"t1": 55.209,
"text": "*HEMEN ABONE OL!*",
"line": 7
}
]