[
{
"t0": 1.26,
"t1": 1.765,
"text": "DUR!",
"line": 0
},
{
"t0": 1.765,
"t1": 2.74,
"text": "KAYDIRMA...",
"line": 0
},
{
"t0": 2.74,
"t1": 3.62,
"text": "BU VİDEO SENİ",
"line": 0
},
{
"t0": 3.62,
"t1": 5.64,
"text": "*DOKSANLARA* GERİ GÖTÜRECEK!",
"line": 0
},
{
"t0": 7.032,
"t1": 8.052,
"text": "KASET Mİ KOPTU?",
"line": 1
},
{
"t0": 8.052,
"t1": 8.949,
"text": "HEMEN BİR",
"line": 1
},
{
"t0": 8.949,
"t1": 10.487,
"text": "*KURŞUN KALEM* BULUNURDU.",
"line": 1
},
{
"t0": 10.487,
"t1": 11.172,
"text": "VE O BANT,",
"line": 1
},
{
"t0": 11.172,
"t1": 12.152,
"text": "SABIRLA,",
"line": 1
},
{
"t0": 12.152,
"t1": 13.692,
"text": "TEK TEK *SARILIRDI.*",
"line": 1
},
{
"t0": 15.12,
"t1": 16.454,
"text": "TÜPLÜ TELEVİZYONDA",
"line": 2
},
{
"t0": 16.454,
"t1": 17.74,
"text": "*KARINCALAR* ÇIKINCA...",
"line": 2
},
{
"t0": 17.74,
"t1": 19.001,
"text": "EVDE BİRİ HEP",
"line": 2
},
{
"t0": 19.001,
"t1": 20.475,
"text": "*ANTENİN* BAŞINDA BEKLERDİ.",
"line": 2
},
{
"t0": 20.475,
"t1": 21.89,
"text": "TAMAM! TAMAM!",
"line": 2
},
{
"t0": 21.89,
"t1": 22.89,
"text": "*ORADA DUR!*",
"line": 2
},
{
"t0": 24.32,
"t1": 25.39,
"text": "*TELEFON KARTI!*",
"line": 3
},
{
"t0": 25.39,
"t1": 26.76,
"text": "KONTÖR BİTMESİN DİYE,",
"line": 3
},
{
"t0": 26.76,
"t1": 27.96,
"text": "BÜTÜN HAYATINI",
"line": 3
},
{
"t0": 27.96,
"t1": 29.62,
"text": "*ÜÇ DAKİKAYA* SIĞDIRIRDIN.",
"line": 3
},
{
"t0": 31.009,
"t1": 32.204,
"text": "BİR BUÇUK MEGABAYTLIK",
"line": 4
},
{
"t0": 32.204,
"t1": 33.099,
"text": "*DİSKET...*",
"line": 4
},
{
"t0": 33.099,
"t1": 34.204,
"text": "O ZAMAN BU,",
"line": 4
},
{
"t0": 34.204,
"t1": 35.849,
"text": "KOCA BİR *HAZİNEYDİ.*",
"line": 4
},
{
"t0": 37.214,
"t1": 38.353,
"text": "CEP OYUNCAĞINDAKİ",
"line": 5
},
{
"t0": 38.353,
"t1": 39.694,
"text": "*SANAL BEBEK* ACIKINCA,",
"line": 5
},
{
"t0": 39.694,
"t1": 40.523,
"text": "BÜTÜN SINIF",
"line": 5
},
{
"t0": 40.523,
"t1": 41.804,
"text": "*ALARMA* GEÇERDİ!",
"line": 5
},
{
"t0": 43.211,
"t1": 44.438,
"text": "VE SOKAK LAMBALARI",
"line": 6
},
{
"t0": 44.438,
"t1": 45.241,
"text": "*YANDIĞINDA...*",
"line": 6
},
{
"t0": 45.241,
"t1": 46.471,
"text": "*HERKES EVE!*",
"line": 6
},
{
"t0": 48.31,
"t1": 49.855,
"text": "PEKİ SEN DOKSANLARDAN",
"line": 7
},
{
"t0": 49.855,
"t1": 51.25,
"text": "EN ÇOK *NEYİ ÖZLEDİN?*",
"line": 7
},
{
"t0": 51.25,
"t1": 52.415,
"text": "*YORUMLARA YAZ.*",
"line": 7
},
{
"t0": 52.415,
"t1": 53.805,
"text": "DOKSANLAR ÇOCUKLARI,",
"line": 7
},
{
"t0": 53.805,
"t1": 54.91,
"text": "*BURADA MISINIZ?*",
"line": 7
}
]