[
{
"t0": 0.96,
"t1": 1.89,
"text": "BİR ZAMANLAR",
"line": 0
},
{
"t0": 1.89,
"t1": 2.964,
"text": "HER APARTMANIN",
"line": 0
},
{
"t0": 2.964,
"t1": 4.16,
"text": "BİR *KRALI* VARDI...",
"line": 0
},
{
"t0": 4.16,
"t1": 5.16,
"text": "*KAPICI!*",
"line": 0
},
{
"t0": 5.766,
"t1": 7.091,
"text": "SABAHIN YEDİSİNDE",
"line": 1
},
{
"t0": 7.091,
"t1": 8.606,
"text": "*EKMEK, GAZETE, SÜT...*",
"line": 1
},
{
"t0": 8.606,
"t1": 10.056,
"text": "ÜST KATTAN İPLE",
"line": 1
},
{
"t0": 10.056,
"t1": 11.336,
"text": "*SEPET* SARKITILIR,",
"line": 1
},
{
"t0": 11.336,
"t1": 13.02,
"text": "KAPICI DA *SICAK EKMEĞİ*",
"line": 1
},
{
"t0": 13.02,
"t1": 14.436,
"text": "İÇİNE KOYARDI.",
"line": 1
},
{
"t0": 15.058,
"t1": 16.953,
"text": "KIŞIN *KÖMÜR KAMYONU* GELİNCE,",
"line": 2
},
{
"t0": 16.953,
"t1": 17.914,
"text": "BÜTÜN GÜN",
"line": 2
},
{
"t0": 17.914,
"t1": 18.948,
"text": "*KÜREK* SALLARDI.",
"line": 2
},
{
"t0": 18.948,
"t1": 20.788,
"text": "KALORİFER YANMADIYSA...",
"line": 2
},
{
"t0": 20.788,
"t1": 22.288,
"text": "*SUÇLU BELLİYDİ!*",
"line": 2
},
{
"t0": 22.884,
"t1": 23.879,
"text": "KİM TAŞINDI,",
"line": 3
},
{
"t0": 23.879,
"t1": 25.004,
"text": "KİM EVLENDİ,",
"line": 3
},
{
"t0": 25.004,
"t1": 26.599,
"text": "KİME MİSAFİR GELDİ...",
"line": 3
},
{
"t0": 26.599,
"t1": 27.238,
"text": "APARTMANIN",
"line": 3
},
{
"t0": 27.238,
"t1": 28.714,
"text": "*CANLI ARŞİVİYDİ.*",
"line": 3
},
{
"t0": 29.372,
"t1": 30.552,
"text": "PEKİ *NE OLDU?*",
"line": 4
},
{
"t0": 30.552,
"t1": 32.082,
"text": "*DOĞALGAZ* GELDİ,",
"line": 4
},
{
"t0": 32.082,
"t1": 32.747,
"text": "KÖMÜR GİTTİ.",
"line": 4
},
{
"t0": 32.747,
"t1": 34.227,
"text": "*MARKET* KAPIYA GELDİ.",
"line": 4
},
{
"t0": 34.227,
"t1": 35.888,
"text": "YENİ BİNALARIN ÇOĞUNDA",
"line": 4
},
{
"t0": 35.888,
"t1": 37.421,
"text": "ARTIK *KAPICI DAİRESİ*",
"line": 4
},
{
"t0": 37.421,
"t1": 38.502,
"text": "BİLE YOK.",
"line": 4
},
{
"t0": 39.111,
"t1": 40.631,
"text": "YERİNE *SİTE YÖNETİMİ,*",
"line": 5
},
{
"t0": 40.631,
"t1": 41.601,
"text": "*KAMERALAR*",
"line": 5
},
{
"t0": 41.601,
"t1": 42.996,
"text": "VE *AKILLI KİLİTLER* ALDI.",
"line": 5
},
{
"t0": 42.996,
"t1": 44.166,
"text": "AMA HİÇBİRİ,",
"line": 5
},
{
"t0": 44.166,
"t1": 45.581,
"text": "BAYRAMDA KAPINI ÇALIP",
"line": 5
},
{
"t0": 45.581,
"t1": 46.933,
"text": "*\"BAYRAMINIZ MÜBAREK OLSUN\"*",
"line": 5
},
{
"t0": 46.933,
"t1": 47.811,
"text": "DEMEDİ.",
"line": 5
},
{
"t0": 48.703,
"t1": 49.893,
"text": "SENİN APARTMANININ",
"line": 6
},
{
"t0": 49.893,
"t1": 51.258,
"text": "*KAPICISININ ADI* NEYDİ?",
"line": 6
},
{
"t0": 51.258,
"t1": 52.523,
"text": "*YORUMLARA YAZ.*",
"line": 6
},
{
"t0": 52.981,
"t1": 54.155,
"text": "KAYBOLAN MESLEKLER",
"line": 7
},
{
"t0": 54.155,
"t1": 55.651,
"text": "SERİSİNİ KAÇIRMAMAK İÇİN...",
"line": 7
},
{
"t0": 55.651,
"t1": 57.071,
"text": "*HEMEN ABONE OL!*",
"line": 7
}
]