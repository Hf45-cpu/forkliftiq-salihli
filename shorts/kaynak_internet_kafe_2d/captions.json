[
{
"t0": 0.95,
"t1": 2.92,
"text": "ABİ, *BİR SAAT* AÇAR MISIN?",
"line": 0
},
{
"t0": 2.92,
"t1": 4.44,
"text": "*YİRMİ DAKİKAM KALDI!*",
"line": 0
},
{
"t0": 6.282,
"t1": 7.727,
"text": "OKUL ÇIKIŞI SOLUĞU",
"line": 1
},
{
"t0": 7.727,
"t1": 8.682,
"text": "*İNTERNET KAFEDE* ALIRDIK.",
"line": 1
},
{
"t0": 8.682,
"t1": 10.092,
"text": "*TÜPLÜ MONİTÖRLER,*",
"line": 1
},
{
"t0": 10.092,
"t1": 11.462,
"text": "GICIRDAYAN SANDALYELER,",
"line": 1
},
{
"t0": 11.462,
"t1": 13.402,
"text": "BİTMEYEN *KLAVYE SESLERİ...*",
"line": 1
},
{
"t0": 14.488,
"t1": 16.086,
"text": "*KULAKLIKLARI* TAKINCA",
"line": 2
},
{
"t0": 16.086,
"t1": 17.063,
"text": "DÜNYA DURURDU.",
"line": 2
},
{
"t0": 17.063,
"t1": 18.303,
"text": "*TAKIMLAR KURULUR,*",
"line": 2
},
{
"t0": 18.303,
"t1": 21.398,
"text": "BÜTÜN KAFE AYNI OYUNDA *KAPIŞIRDI!*",
"line": 2
},
{
"t0": 22.692,
"t1": 24.322,
"text": "BİR DE *MESAJLAŞMA...*",
"line": 3
},
{
"t0": 24.322,
"t1": 26.202,
"text": "*TİTREŞİM* GÖNDERİR,",
"line": 3
},
{
"t0": 26.202,
"t1": 29.582,
"text": "ŞARKI SÖZLÜ *DURUM MESAJLARI* YAZARDIK.",
"line": 3
},
{
"t0": 30.601,
"t1": 31.556,
"text": "PEKİ *NE OLDU?*",
"line": 4
},
{
"t0": 31.556,
"t1": 33.526,
"text": "EVLERE *HIZLI İNTERNET* GELDİ,",
"line": 4
},
{
"t0": 33.526,
"t1": 35.561,
"text": "CEBİMİZE *AKILLI TELEFON* GİRDİ.",
"line": 4
},
{
"t0": 37.478,
"t1": 39.848,
"text": "KAFELER BİRER BİRER *KAPANDI.*",
"line": 5
},
{
"t0": 39.848,
"t1": 41.923,
"text": "O *“SÜRENİZ DOLDU”* UYARISI...",
"line": 5
},
{
"t0": 41.923,
"t1": 43.848,
"text": "*ARTIK HİÇ ÇIKMIYOR.*",
"line": 5
},
{
"t0": 46.292,
"t1": 48.182,
"text": "SENİN GİTTİĞİN",
"line": 6
},
{
"t0": 48.182,
"t1": 49.932,
"text": "*KAFENİN ADI* NEYDİ?",
"line": 6
},
{
"t0": 49.932,
"t1": 51.352,
"text": "*YORUMLARA YAZ.*",
"line": 6
},
{
"t0": 52.204,
"t1": 53.264,
"text": "KAYBOLAN MESLEKLER",
"line": 7
},
{
"t0": 53.264,
"t1": 55.284,
"text": "SERİSİNİ KAÇIRMAMAK İÇİN...",
"line": 7
},
{
"t0": 55.284,
"t1": 56.654,
"text": "*HEMEN ABONE OL!*",
"line": 7
}
]