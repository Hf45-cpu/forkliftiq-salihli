[
{
"t0": 0.97,
"t1": 2.115,
"text": "SABAHIN KÖRÜNDE",
"line": 0
},
{
"t0": 2.115,
"t1": 3.28,
"text": "BİR *ZİL SESİ...*",
"line": 0
},
{
"t0": 3.28,
"t1": 4.36,
"text": "*SÜTÇÜ GELDİ!*",
"line": 0
},
{
"t0": 5.588,
"t1": 7.223,
"text": "AT ARABASINDA *GÜĞÜMLER,*",
"line": 1
},
{
"t0": 7.223,
"t1": 8.338,
"text": "ELİNDE *ÖLÇEK.*",
"line": 1
},
{
"t0": 8.338,
"t1": 10.158,
"text": "ANNEMİZ *TENCEREYİ* UZATIR,",
"line": 1
},
{
"t0": 10.158,
"t1": 12.078,
"text": "SÜT *LİTRE LİTRE* DÖKÜLÜRDÜ.",
"line": 1
},
{
"t0": 13.433,
"t1": 15.303,
"text": "SONRA OCAKTA *KAYNATILIRDI.*",
"line": 2
},
{
"t0": 15.303,
"t1": 17.663,
"text": "GÖZ AÇIP KAPAYINCAYA KADAR *TAŞAR,*",
"line": 2
},
{
"t0": 17.663,
"t1": 19.653,
"text": "BÜTÜN MUTFAK *SÜT KOKARDI!*",
"line": 2
},
{
"t0": 20.9,
"t1": 22.504,
"text": "ÜSTÜNDEKİ *KAYMAK* İÇİN DE",
"line": 3
},
{
"t0": 22.504,
"t1": 24.3,
"text": "KARDEŞLER *KAVGA EDERDİ.*",
"line": 3
},
{
"t0": 26.154,
"t1": 27.084,
"text": "PEKİ *NE OLDU?*",
"line": 4
},
{
"t0": 27.084,
"t1": 28.624,
"text": "ÖNCE *ŞİŞE SÜT* GELDİ,",
"line": 4
},
{
"t0": 28.624,
"t1": 29.634,
"text": "SONRA *KUTU SÜT.*",
"line": 4
},
{
"t0": 29.634,
"t1": 31.674,
"text": "*MARKETLER* HER KÖŞEYE AÇILDI.",
"line": 4
},
{
"t0": 32.973,
"t1": 34.733,
"text": "*SAĞLIK KURALLARI* SIKILAŞTI,",
"line": 5
},
{
"t0": 34.733,
"t1": 37.073,
"text": "KAPI KAPI AÇIK SÜT SATIŞI *AZALDI.*",
"line": 5
},
{
"t0": 37.073,
"t1": 38.323,
"text": "VE O SABAH ZİLİ...",
"line": 5
},
{
"t0": 38.323,
"t1": 39.433,
"text": "*ARTIK ÇALMIYOR.*",
"line": 5
},
{
"t0": 42.055,
"t1": 42.945,
"text": "SENİN MAHALLENE",
"line": 6
},
{
"t0": 42.945,
"t1": 44.115,
"text": "*SÜTÇÜ* GELİR MİYDİ?",
"line": 6
},
{
"t0": 44.115,
"t1": 45.195,
"text": "*YORUMLARA YAZ.*",
"line": 6
},
{
"t0": 46.02,
"t1": 47.03,
"text": "KAYBOLAN MESLEKLER",
"line": 7
},
{
"t0": 47.03,
"t1": 48.61,
"text": "SERİSİNİ KAÇIRMAMAK İÇİN...",
"line": 7
},
{
"t0": 48.61,
"t1": 49.9,
"text": "*HEMEN ABONE OL!*",
"line": 7
}
]